# PostgreSQL connection string for Prisma ORM (e.g. Render PostgreSQL Internal/External URL)
DATABASE_URL="postgresql://user:password@host:5432/minisocial?sslmode=require"

# Public app URL (Render automatically sets RENDER_EXTERNAL_URL; set APP_URL if using a custom domain)
APP_URL="https://your-app.onrender.com"

# Google OAuth 2.0 credentials (from https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <YOUR_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Random secret for signing HttpOnly session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=""

# Optional YouTube Data API v3 key (server-side only; enables richer stats, Shorts duration filtering, and YouTube comments)
YOUTUBE_API_KEY=""

